<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <ImageView
        android:id="@+id/campusPreviewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:src="@drawable/campus_360"
        android:contentDescription="@string/scan_assist_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="12dp"
        android:background="#99000000">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/notification_icon_bg"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:contentDescription="Back"
            app:tint="#1A1A1A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_assist_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lookDirectionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Drag to look around · Turn left / right"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        android:padding="20dp"
        android:elevation="10dp">

        <TextView
            android:id="@+id/guidanceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Look around in 360°"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/guidanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_assist_hint"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp" />

        <TextView
            android:id="@+id/detectedLabels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/turnLeftButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:contentDescription="Turn left"
                android:text="Turn left"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="#111827" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/turnRightButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:contentDescription="Turn right"
                android:text="Turn right"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="#111827" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#111111"
            android:contentDescription="@string/scan_button"
            android:text="@string/scan_button"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/repeatButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Repeat audio"
            android:text="Repeat audio"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="14sp"
            android:visibility="gone"
            app:cornerRadius="14dp"
            app:strokeColor="#111827" />
    </LinearLayout>

</FrameLayout>
