<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0E8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Top bar: notifications only -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <FrameLayout
                    android:id="@+id/notificationButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:background="@drawable/notification_icon_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notifications"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notifications"
                        app:tint="#1A1A1A"
                        android:contentDescription="@null" />

                    <View
                        android:id="@+id/notificationBadge"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/unread_dot" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi there!"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Where do you want to check today?"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- PRIMARY: Scan Assist -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanAssistButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/home_scan_cta"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFFFF"
                app:icon="@drawable/ic_camera"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                android:contentDescription="@string/home_scan_subtitle"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_scan_subtitle"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- Map preview circle -->
            <FrameLayout
                android:id="@+id/mapPreviewContainer"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open map">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/dashed_circle" />

                <androidx.cardview.widget.CardView
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="74dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/mapPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/map_preview"
                        android:contentDescription="Map preview" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#33000000" />

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/map_pin_circle">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_map_pin"
                            android:contentDescription="@null" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap circle for live map"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Floating bubble navbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:background="@drawable/navbar_pill_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_gravity="center">

            <View
                android:id="@+id/bubbleHome"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/nav_bubble"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                app:tint="#2A2A2A"
                android:contentDescription="Home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navReport"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_gravity="center">

            <View
                android:id="@+id/bubbleReport"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/nav_bubble"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/iconReport"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_input_add"
                app:tint="#FFFFFF"
                android:contentDescription="Report" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navMyReports"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_gravity="center">

            <View
                android:id="@+id/bubbleMyReports"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/nav_bubble"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/iconMyReports"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#FFFFFF"
                android:contentDescription="My Reports" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_gravity="center">

            <View
                android:id="@+id/bubbleProfile"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/nav_bubble"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_profile"
                app:tint="#FFFFFF"
                android:contentDescription="Profile" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
