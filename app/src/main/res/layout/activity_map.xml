<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: back button + campus search + two-field route panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/notification_icon_bg"
                android:src="@drawable/ic_back"
                android:padding="10dp"
                android:contentDescription="Back"
                android:layout_marginEnd="10dp"
                app:tint="#1A1A1A" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Default: single campus/report search field -->
                <LinearLayout
                    android:id="@+id/searchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/search_bar_bg"
                    android:elevation="4dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#6B7280"
                        android:contentDescription="@null"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search places or reports"
                        android:textColorHint="#9CA3AF"
                        android:textColor="#1A1A1A"
                        android:textSize="15sp"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <!-- Shown after "Directions" is tapped in the bottom sheet -->
                <LinearLayout
                    android:id="@+id/routePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/search_bar_bg"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:visibility="gone">

                    <!-- Live Google Places predictions, shown while typing in searchInput -->
                    <ListView
                        android:id="@+id/searchPredictionsList"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="52dp"
                        android:background="@android:color/white"
                        android:elevation="6dp"
                        android:divider="#E5E7EB"
                        android:dividerHeight="1dp"
                        android:visibility="gone" />

                    <!-- Current location field + use-my-location icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#6B7280"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <EditText
                            android:id="@+id/currentLocationInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Current location"
                            android:textColorHint="#9CA3AF"
                            android:textColor="#1A1A1A"
                            android:textSize="15sp"
                            android:inputType="text"
                            android:maxLines="1"
                            android:importantForAutofill="no" />


                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp" />

                    <!-- Destination field + find-route search icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_mapmode"
                            app:tint="#6B7280"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <EditText
                            android:id="@+id/destinationInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Destination"
                            android:textColorHint="#9CA3AF"
                            android:textColor="#1A1A1A"
                            android:textSize="15sp"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:importantForAutofill="no" />

                        <ImageButton
                            android:id="@+id/findRouteButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="#6B7280"
                            android:contentDescription="Show accessible route" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- My location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/myLocationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="320dp"
        android:contentDescription="My location"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#FFFFFF"
        app:tint="#1A1A1A"
        app:fabSize="mini"
        app:elevation="6dp" />

    <!-- Zoom in FAB, stacked directly below the my-location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/zoomInButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="262dp"
        android:contentDescription="Zoom in"
        app:srcCompat="@drawable/ic_zoom_in"
        app:backgroundTint="#FFFFFF"
        app:tint="#1A1A1A"
        app:fabSize="mini"
        app:elevation="6dp" />

    <!-- Zoom out FAB, stacked directly below the zoom-in FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/zoomOutButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="204dp"
        android:contentDescription="Zoom out"
        app:srcCompat="@drawable/ic_zoom_out"
        app:backgroundTint="#FFFFFF"
        app:tint="#1A1A1A"
        app:fabSize="mini"
        app:elevation="6dp" />

    <!-- Location / obstacle bottom sheet -->
    <LinearLayout
        android:id="@+id/locationSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        android:padding="20dp"
        android:elevation="12dp"
        android:visibility="gone">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#4DFFFFFF"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Multimedia University - MMU Cyberjaya"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/directionsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Directions"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#8AB4FF"
                app:icon="@android:drawable/ic_menu_mapmode"
                app:iconTint="#8AB4FF"
                app:iconSize="16dp"
                app:iconPadding="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campus map · obstacles shown in red"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportObstacleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Add Marker"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#1A1A1A"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewReportsButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="View reports"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#FFFFFF"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>