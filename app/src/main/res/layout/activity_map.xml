<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: back button + campus search + two-field route panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/notification_icon_bg"
                android:src="@drawable/ic_back"
                android:padding="10dp"
                android:contentDescription="Back"
                android:layout_marginEnd="10dp"
                app:tint="#1A1A1A" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/searchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/search_bar_bg"
                    android:elevation="4dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#6B7280"
                        android:contentDescription="@null"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search places or reports"
                        android:textColorHint="#9CA3AF"
                        android:textColor="#1A1A1A"
                        android:textSize="15sp"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/routePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/search_bar_bg"
                    android:elevation="4dp"
                    android:padding="4dp"
                    android:visibility="gone">

                    <!-- Current location field + use-my-location icon -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#6B7280"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <EditText
                            android:id="@+id/currentLocationInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Current location"
                            android:textColorHint="#9CA3AF"
                            android:textColor="#1A1A1A"
                            android:textSize="15sp"
                            android:inputType="text"
                            android:maxLines="1"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_mapmode"
                            app:tint="#6B7280"
                            android:contentDescription="@null"
                            android:layout_marginEnd="8dp" />

                        <EditText
                            android:id="@+id/destinationInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Destination"
                            android:textColorHint="#9CA3AF"
                            android:textColor="#1A1A1A"
                            android:textSize="15sp"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:importantForAutofill="no" />

                        <ImageButton
                            android:id="@+id/findRouteButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="#6B7280"
                            android:contentDescription="Show accessible route" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Live search filter results under the search bar -->
        <ListView
            android:id="@+id/searchPredictionsList"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/search_bar_bg"
            android:divider="#E5E7EB"
            android:dividerHeight="1dp"
            android:elevation="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Map controls: sit above the bottom sheet and draw on top of it -->
    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
        android:elevation="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/myLocationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="My location"
            app:srcCompat="@android:drawable/ic_menu_mylocation"
            app:backgroundTint="#FFFFFF"
            app:tint="#1A1A1A"
            app:fabSize="mini"
            app:elevation="8dp"
            app:borderWidth="0dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/zoomInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="Zoom in"
            app:srcCompat="@drawable/ic_zoom_in"
            app:backgroundTint="#FFFFFF"
            app:tint="#1A1A1A"
            app:fabSize="mini"
            app:elevation="8dp"
            app:borderWidth="0dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/zoomOutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Zoom out"
            app:srcCompat="@drawable/ic_zoom_out"
            app:backgroundTint="#FFFFFF"
            app:tint="#1A1A1A"
            app:fabSize="mini"
            app:elevation="8dp"
            app:borderWidth="0dp" />
    </LinearLayout>

    <!-- Location / obstacle bottom sheet -->
    <LinearLayout
        android:id="@+id/locationSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:elevation="16dp"
        android:visibility="gone">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#D1D5DB"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Walk"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/directionsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Directions"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#1A73E8"
                app:icon="@android:drawable/ic_menu_directions"
                app:iconTint="#1A73E8"
                app:iconSize="16dp"
                app:iconPadding="4dp" />
        </LinearLayout>

        <!-- Travel mode chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/modeWalkChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Walk · —"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A73E8"
                android:background="#E8F0FE"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/modeDriveChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drive · —"
                android:textSize="13sp"
                android:textColor="#4B5563"
                android:background="#F3F4F6"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- ETA row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/sheetEtaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#188038"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sheetArriveText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Arrive —"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheetRouteMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fastest walking route"
                    android:textColor="#6B7280"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Place card with photo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F9FAFB"
            android:padding="10dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/sheetPlacePhoto"
                android:layout_width="88dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:src="@drawable/sample_report_corridor"
                android:contentDescription="Place photo"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/sheetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nearby places"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/sheetSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Map · obstacles shown in red"
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startDirectionsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Start directions"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="24dp"
            android:backgroundTint="#1A73E8"
            android:layout_marginBottom="10dp"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportObstacleButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Add Marker"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                android:backgroundTint="#111827"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewReportsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="View reports"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                app:strokeColor="#111827"
                android:textColor="#111827"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Turn-by-turn navigation mode (Google Maps style) ===== -->
    <LinearLayout
        android:id="@+id/navigationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="20dp">

        <!-- Top instruction banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#0B8043"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginEnd="14dp">

                    <TextView
                        android:id="@+id/navTurnIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↗"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/navStepDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80 m"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/navStepStreet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Persiaran Newron"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/navThenText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#0B8043"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Then ↑ Continue"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Obstacle alert: switch to safer route or keep current -->
        <LinearLayout
            android:id="@+id/obstacleAlertCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:background="@drawable/bottom_sheet_bg"
            android:elevation="12dp"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ Obstacle ahead"
                android:textColor="#B45309"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/obstacleAlertMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="An obstacle is on your route. Switch to a safer path that avoids it?"
                android:textColor="#374151"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/obstacleKeepRouteButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep route"
                    android:textAllCaps="false"
                    android:textColor="#4B5563" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/obstacleAvoidButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Avoid obstacle"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    android:backgroundTint="#0B8043"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom journey sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bottom_sheet_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="#D1D5DB"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/navEtaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 min"
                        android:textColor="#188038"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/navMetaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21 km · 10:49 AM"
                        android:textColor="#4B5563"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/navExitButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="96dp"
                    android:text="Exit"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    android:backgroundTint="#D93025"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
